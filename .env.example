# ============================================================
# Atruvia AG — Stablecoin-Plattform: Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus.
# NIEMALS die .env-Datei committen!
# ============================================================

# ── Datenbankverbindung ──────────────────────────────────────
DATABASE_URL=jdbc:postgresql://host:5432/stablecoin
DATABASE_USERNAME=stablecoin
DATABASE_PASSWORD=

# ── Sicherheit ───────────────────────────────────────────────
# Mindestlänge: 32 Zeichen (256 Bit für HS256)
JWT_SECRET=
# Token-Gültigkeit in Millisekunden (Standard: 3600000 = 1 h)
JWT_EXPIRATION_MS=3600000

# ── Circle API (USDC/EURC) ───────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com
CIRCLE_MASTER_WALLET_ID=

# ── Taurus Custody (On-Chain-Signing) ────────────────────────
TAURUS_API_KEY=
TAURUS_BASE_URL=

# ── Chainalysis (AML/Adress-Screening) ───────────────────────
CHAINALYSIS_API_KEY=
CHAINALYSIS_BASE_URL=https://api.chainalysis.com

# ── Core Banking (Kernbankensystem) ──────────────────────────
CORE_BANKING_BASE_URL=
CORE_BANKING_API_KEY=

# ── n8n (Workflow-Automatisierung / Settlement-Webhook) ──────
N8N_WEBHOOK_URL=

# ── SSL/mTLS (nur Produktion) ────────────────────────────────
# PKCS12-Keystore für Server-Zertifikat und Client-Auth
SSL_KEYSTORE_PATH=/etc/ssl/stablecoin/server.p12
SSL_KEYSTORE_PASSWORD=
SSL_TRUSTSTORE_PATH=/etc/ssl/stablecoin/truststore.p12
SSL_TRUSTSTORE_PASSWORD=
